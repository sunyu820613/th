# SAP BTP Agent — 环境变量示例
# 复制为 .env 并填入真实值；.env 已加入 .gitignore，禁止提交真实值。
# 具体变量名将在 Phase 1（Foundation）/ Phase 5（BTP Integration）落地时
# 根据 Codex 研究报告（docs/research/001-...md）与实际服务绑定确认，
# 以下为占位结构，不代表最终确定的变量名。

# --- 应用基础配置 ---
APP_ENV=local
LOG_LEVEL=INFO

# --- LLM Provider（Phase 1 引入抽象层，先支持 Mock） ---
LLM_PROVIDER=mock

# --- SAP AI Core / Generative AI Hub（占位，Phase 5 确认真实字段名） ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# --- Destination Service（占位） ---
DESTINATION_SERVICE_URL=
DESTINATION_CLIENT_ID=
DESTINATION_CLIENT_SECRET=

# --- XSUAA（占位） ---
XSUAA_URL=
XSUAA_CLIENT_ID=
XSUAA_CLIENT_SECRET=

# --- SAP HANA Cloud（可选，占位） ---
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=
